<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>Ali Abdullah Yılmaz</Authors>
    <Copyright>Copyright 2026 Ali Abdullah Yılmaz</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://bever.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bever-team/bever</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bever;business-applications;dsl;low-code;aspnetcore</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)eng/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
